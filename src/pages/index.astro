						<p>Play<br />Ludus liber</p>
					</div>
					<div class="garden-label label-eight" data-garden-label="7">
						<span>08</span>
						<p>Read<br />Lectio lenta</p>
					</div>

					<svg
						class="garden-grass"
						viewBox="0 0 1440 170"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						{
							grassTufts.map((tuft, tuftIndex) => (
								<g
									class="grass-tuft-position"
									data-grass-growth={tuft.seedIndex}
									transform={`translate(${tuft.x.toFixed(1)} ${tuft.y.toFixed(1)})`}
								>
									<g class="grass-tuft-size" transform={`scale(${tuft.scale})`}>
										<g class="grass-tuft" data-grass-tuft={tuftIndex}>
											{tuft.blades.map((blade) => (
												<path class="grass-blade" d={blade} />
											))}
										</g>
									</g>
								</g>
							))
						}
					</svg>

					<div class="garden-ground">
						<svg viewBox="0 0 1440 170" preserveAspectRatio="none" aria-hidden="true">
							<path d="M0 87C125 56 224 122 354 93s204-49 336-10 231 22 344-17 254-8 406 18v86H0Z" />
						</svg>
					</div>
				</div>

				<div class="signal-grid">
					{
						signals.map((signal) => (
							<div class="signal" data-signal>
								<span>{signal.label}</span>
								<strong data-signal-value={signal.value} data-signal-kind={signal.kind}>
									{signal.value}
								</strong>
							</div>
						))
					}
				</div>
			</section>

			<section class="closing" aria-labelledby="closing-title" data-closing>
				<div class="closing-rings" aria-hidden="true">
					<span class="closing-ring closing-ring-pulse"></span>
					<span class="closing-ring closing-ring-pulse"></span>
					<span class="closing-ring closing-ring-pulse"></span>
					<span class="closing-ring closing-ring-pulse"></span>
					<span class="closing-ring closing-ring-pulse"></span>
					<span class="closing-ring closing-ring-origin"></span>
				</div>
				<div class="closing-content">
					<div class="closing-flower" aria-hidden="true">
						<svg viewBox="0 0 200 200">
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(45 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(90 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(135 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(180 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(225 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(270 100 100)" />
							<path d="M100 100C78 80 75 44 100 24c25 20 22 56 0 76Z" transform="rotate(315 100 100)" />
							<circle cx="100" cy="100" r="14" />
						</svg>
					</div>
					<p class="eyebrow">A garden is a decision made visible</p>
					<h2 id="closing-title">
						<span>Your attention</span>
						<span>is still <em>yours.</em></span>
					</h2>
					<p class="closing-summary" data-closing-summary aria-live="polite">
						<strong data-closing-count>01</strong>
						<span data-closing-message>
							choice made. One deliberate choice is enough to change what grows
							next.
						</span>
					</p>
					<a class="closing-cta" href="#seeds">
						<span data-closing-cta>Choose another seed</span>
						<svg aria-hidden="true" viewBox="0 0 30 30">
							<path d="M5 15h20m-7-7 7 7-7 7" />
						</svg>
					</a>
				</div>
				<footer>
					<span>ALG / GRDN © 2026</span>
					<span>Astro × GSAP × Webflow Cloud</span>
					<a href="#top">Back to top ↑</a>
				</footer>
			</section>
		</main>
		<script>
			import '../animations/hero-grid-distortion.js';
			import '../animations/hero-interruption.js';
			import '../animations/interruption-section.js';
			import '../animations/seed-bank.js';
			import '../animations/garden-growth.js';
			import '../animations/mouse-ripple.js';
			import '../animations/closing-reveal.js';
		</script>
	</body>
</html>
