---
import '../styles/global.css';

const seeds = [
	{ id: '01', name: 'Make', note: 'something with your hands', color: 'coral' },
	{ id: '02', name: 'Wander', note: 'without a destination', color: 'blue' },
	{ id: '03', name: 'Listen', note: 'before you answer', color: 'violet' },
	{ id: '04', name: 'Gather', note: 'around something real', color: 'lime' },
	{ id: '05', name: 'Notice', note: 'what usually passes unseen', color: 'amber' },
	{ id: '06', name: 'Repair', note: 'instead of replacing', color: 'teal' },
	{ id: '07', name: 'Play', note: 'without measuring the outcome', color: 'magenta' },
	{ id: '08', name: 'Read', note: 'beyond the recommendation', color: 'burgundy' },
];

const signals = [
	{ label: 'Choices made by you', value: '00', kind: 'chosen' },
	{ label: 'Trends consulted', value: '00', kind: 'trends' },
	{ label: 'Possibilities growing', value: '08', kind: 'possibilities' },
];

const groundSegments = [
	[[0, 87], [125, 56], [224, 122], [354, 93]],
	[[354, 93], [484, 64], [558, 44], [690, 83]],
	[[690, 83], [822, 122], [921, 105], [1034, 66]],
	[[1034, 66], [1147, 27], [1288, 58], [1440, 84]],
];

const cubicCoordinate = (start, controlOne, controlTwo, end, progress) => {
	const inverse = 1 - progress;
	return (
		inverse ** 3 * start +
		3 * inverse ** 2 * progress * controlOne +
		3 * inverse * progress ** 2 * controlTwo +
		progress ** 3 * end
	);
};

const groundYAt = (x) => {
	const segment =
		groundSegments.find((points) => x >= points[0][0] && x <= points[3][0]) ??
		groundSegments.at(-1);
	let low = 0;
	let high = 1;

	for (let index = 0; index < 18; index += 1) {
		const progress = (low + high) / 2;
		const currentX = cubicCoordinate(
			segment[0][0],
			segment[1][0],
			segment[2][0],
			segment[3][0],
			progress,
		);

		if (currentX < x) low = progress;
		else high = progress;
	}

	const progress = (low + high) / 2;
	return cubicCoordinate(
		segment[0][1],
		segment[1][1],
		segment[2][1],
		segment[3][1],
		progress,
	);
};

const grassAnchors = [
	{ seedIndex: 0, x: 252, scale: 2 },
	{ seedIndex: 1, x: 766, scale: 2 },
	{ seedIndex: 2, x: 1190, scale: 2 },
	{ seedIndex: 4, x: 86, scale: 1.45 },
	{ seedIndex: 5, x: 490, scale: 1.45 },
	{ seedIndex: 6, x: 979, scale: 1.45 },
	{ seedIndex: 7, x: 1354, scale: 1.45 },
];

const grassTufts = grassAnchors.map(({ seedIndex, x, scale }, tuftIndex) => {
	const bladeCount = 9;

	return {
		seedIndex,
		scale,
		x,
		y: groundYAt(x) + 3,
		blades: Array.from({ length: bladeCount }, (_, bladeIndex) => {
			const center = (bladeCount - 1) / 2;
			const base = (bladeIndex - center) * 5.2;
			const extraHeight =
				bladeIndex === Math.floor(center) ? 28 : 0;
			const height =
				66 + ((tuftIndex * 29 + bladeIndex * 23) % 58) + extraHeight;
			const lean =
				(bladeIndex - center) * 11 +
				((tuftIndex * 13 + bladeIndex * 7) % 13) -
				6;
			const width = 3.2 + ((tuftIndex + bladeIndex) % 3) * 0.65;

			return `M${(base - width).toFixed(1)} 5Q${(base + lean * 0.18).toFixed(1)} ${(-height * 0.48).toFixed(1)} ${(base + lean).toFixed(1)} ${-height}Q${(base + lean * 0.5).toFixed(1)} ${(-height * 0.43).toFixed(1)} ${(base + width).toFixed(1)} 5Z`;
		}),
	};
});
